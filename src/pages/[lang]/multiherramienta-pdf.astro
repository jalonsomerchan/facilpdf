---
import MultiPdfToolImproved from '../../components/MultiPdfToolImproved.svelte';
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { getLocalizedPath, isLang, type Lang } from '../../i18n/utils';
import { locales } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!isLang(lang)) {
  return Astro.redirect(getLocalizedPath('es', 'multiherramienta-pdf'));
}

const currentLang = lang as Lang;
const copy = {
  es: {
    title: 'Multiherramienta PDF online gratis y privada',
    description:
      'Une, intercala, reordena, selecciona, rota, duplica y numera páginas PDF desde una herramienta privada, sin subir archivos.',
    badge: 'Todo en uno · Procesamiento local · Vista previa',
    h1: 'Multiherramienta PDF',
    lead: 'Organiza e intercala varios PDF en una sola pantalla, aplica cambios por página o por selección y revisa el resultado antes de descargarlo.',
    steps: [
      {
        text: 'Añade uno o varios PDF. Las miniaturas se preparan localmente en tu navegador.',
      },
      {
        text: 'Intercala dos PDF, reordena, selecciona por rango, gira, duplica o elimina páginas. También puedes deshacer cambios.',
      },
      {
        text: 'Personaliza el nombre, añade texto o numeración opcional y genera una copia nueva con vista previa.',
      },
    ],
    infoBlocks: [
      {
        title: 'Tus documentos no se envían a un servidor',
        text: 'La multiherramienta trabaja con pdf-lib y pdf.js en el navegador. El PDF final se crea localmente en tu dispositivo.',
      },
      {
        title: 'Control preciso también en móvil',
        text: 'Puedes mover páginas con botones, usar selecciones rápidas o rangos, aplicar acciones en lote y restaurar páginas eliminadas sin depender del arrastre.',
      },
    ],
    footer: 'Tus archivos se procesan localmente en tu navegador.',
  },
  en: {
    title: 'Free private online PDF multitool',
    description:
      'Merge, interleave, reorder, select, rotate, duplicate and number PDF pages in one private tool without uploading files.',
    badge: 'All in one · Local processing · Preview',
    h1: 'PDF multitool',
    lead: 'Organize and interleave several PDFs on one screen, apply changes per page or to a selection, and review the result before downloading.',
    steps: [
      {
        text: 'Add one or more PDFs. Thumbnails are prepared locally in your browser.',
      },
      {
        text: 'Interleave two PDFs, reorder, select by range, rotate, duplicate or delete pages. You can also undo changes.',
      },
      {
        text: 'Customize the filename, add optional text or page numbers, and create a new copy with a preview.',
      },
    ],
    infoBlocks: [
      {
        title: 'Your documents are not sent to a server',
        text: 'The multitool uses pdf-lib and pdf.js in the browser. The final PDF is created locally on your device.',
      },
      {
        title: 'Precise control on mobile too',
        text: 'Move pages with buttons, use quick selections or ranges, apply bulk actions and restore deleted pages without relying on drag and drop.',
      },
    ],
    footer: 'Your files are processed locally in your browser.',
  },
} as const;

const pageCopy = copy[currentLang];
---

<ToolPageLayout
  lang={currentLang}
  title={pageCopy.title}
  description={pageCopy.description}
  path="multiherramienta-pdf"
  toolId="pdf-multitool"
  badge={pageCopy.badge}
  h1={pageCopy.h1}
  lead={pageCopy.lead}
  steps={pageCopy.steps}
  infoBlocks={pageCopy.infoBlocks}
  footer={pageCopy.footer}
>
  <MultiPdfToolImproved client:load lang={currentLang} />
</ToolPageLayout>
